      "status": "idle"
    },
    {
      "prompt": "低角度跟拍，夏侯澹赤足踏下龙榻，玄色绣金云纹袍摆扫过冰凉地砖，他缓步绕行庾晚音周身，身影在烛光中拉长、扭曲，最终停驻于她右侧斜前方，背光而立，只余轮廓锋利如刃。",
      "dialogue": "本帝不碰你。你若乖乖听话，或许还能多活几日。",
      "audio_prompt": null,
      "use_scene_ref": false,
      "custom_image_url": null,
      "first_frame_url": null,
      "last_frame_url": null,
      "panel_layout": "3-panel",
